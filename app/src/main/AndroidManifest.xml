<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ✅ Internet permission for OpenRouter API and network calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_quizvuln_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_quizvuln_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuizVuln.NoActionBar"
        tools:targetApi="31">

        <!-- ✅ Splash Screen (Launcher Activity) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.QuizVuln.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ✅ Dashboard Activity (Main app screen after splash) -->
        <activity
            android:name=".activities.DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.QuizVuln" />

        <!-- Quiz Activity -->
        <activity
            android:name=".activities.QuizActivity"
            android:exported="false"
            android:theme="@style/Theme.QuizVuln" />

        <!-- Result Activity -->
        <activity
            android:name=".activities.ResultActivity"
            android:exported="false"
            android:theme="@style/Theme.QuizVuln" />

        <!-- Review Answers Activity -->
        <activity
            android:name=".activities.ResultsReviewActivity"
            android:exported="false"
            android:theme="@style/Theme.QuizVuln" />

        <!-- Profile Edit Activity -->
        <activity
            android:name=".activities.ProfileEditActivity"
            android:exported="false"
            android:label="Edit Profile"
            android:theme="@style/Theme.QuizVuln" />

        <!-- Stats Activity -->
        <activity
            android:name=".activities.StatsActivity"
            android:exported="false"
            android:theme="@style/Theme.QuizVuln" />

    </application>

</manifest>
